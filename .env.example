# VOYO Supabase Configuration
# Copy this file to .env and fill in your Supabase project details

# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# After setting these:
# 1. Go to Supabase SQL Editor
# 2. Run the contents of /supabase/schema.sql
# 3. Enable Realtime for tables: universes, reactions, track_stats, voyo_lyrics, video_intelligence, voyo_feed_content
# 4. Reactions, lyrics, universes, and video intelligence will be live!
